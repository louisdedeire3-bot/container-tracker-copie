<!-- sign-in screen (added for the self-hosted version) -->
<div class="auth-gate" id="authGate">
  <div class="auth-card">
    <div>
      <div class="eyebrow">Green Charcoal Namibia · Export logistics</div>
      <h2>Export Container Register</h2>
    </div>

    <p class="hint" id="authWait">Checking your session…</p>

    <form id="authForm" hidden>
      <label for="authEmail">Work email
        <input id="authEmail" type="email" autocomplete="username" autocapitalize="off" spellcheck="false" required>
      </label>
