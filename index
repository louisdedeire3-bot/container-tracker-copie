  }
  const b = current(); if (!b) return;
  const changed = BFIELDS.filter(f => (b[f.k] ?? (f.type === "checkbox" ? false : "")) !== (d[f.k] ?? (f.type === "checkbox" ? false : ""))).map(f => f.l.replace(" *", "").toLowerCase());
  if (!changed.length) { S.dirty = false; msg.className = "hint"; msg.textContent = "No changes"; return; }
  if (d.product !== (b.product || "")) { d.productBy = S.me; d.productAt = Date.now(); }
  if (await write(() => bref(b.id).update({ ...d, ...stamp(b, "Details updated: " + changed.join(", ")) }), msg)) { S.dirty = false; msg.className = "hint"; msg.textContent = "Saved"; }
}
async function deleteBooking(b) { if (await write(() => bref(b.id).delete())) { S.open.delete(b.id); S.closed.delete(b.id); closePanel(true); render(); } }
async function uploadFiles(files, errEl) {
  const added = [];
  for (const file of files) {
    const ext = (file.name.split(".").pop() || "").toLowerCase(); const type = ACCEPT[ext];
    const say = (m) => { if (errEl) { errEl.className = "err"; errEl.textContent = m; } else setStatus(m, "warn"); };
    if (!type) { say(`${file.name}: format not supported (convert it to PDF).`); continue; }
    if (file.size > MAX_BYTES) { say(`${file.name}: larger than 20 MB.`); continue; }
    try { const r = await S.assets.upload(file, { type }); added.push({ id: r.id, name: file.name, size: r.sizeBytes, at: Date.now(), by: S.me }); }
    catch (e) { say(file.name + ": " + (e.code === "quota_or_state" ? "storage is full." : e.code === "rate_limited" ? "too many uploads, try again shortly." : "upload failed.")); }
  }
  return added;
}

// ================= CSV =================
async function exportCsv() {
  const head = ["Booking", "Client", "Vessel", "Voyage", "Destination", "Stack closure", "Container", "Seal", "Status", "Location", "Pickup transporter", "KETU transporter", "Port transporter", "Vanning saved", "Status since", "Stage"];
  const esc = (v) => { const s = v == null ? "" : String(v); return /[,"\n\r]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
  const lines = [head.join(",")];
  for (const b of [...S.open.values(), ...S.closed.values()]) {
    const openS = STAGE_NAMES[stageOf(b)];
    const cs = conts(b);
    const rows = cs.length ? cs : [null];
    for (const c of rows) lines.push([b.bookingNo, b.client, b.vessel, b.voyage, b.pod, cutoffOf(b), c?.number, c?.seal, c ? CST[c.status || 0].label : "", c ? (c.loc || "") : "", c ? tName(c.t?.pickup) : "", c ? tName(c.t?.ketu) : "", c ? tName(c.t?.port) : "", c ? (c.vanning && (c.vanning.ok || (c.vanning.files || []).length) ? "yes" : "no") : "", c?.statusAt ? new Date(c.statusAt).toISOString().slice(0, 16).replace("T", " ") : "", openS].map(esc).join(","));
  }
  if (!S.downloads) { setStatus("Downloads are not available in this view.", "warn"); return; }
  try { await S.downloads.save({ filename: "export-register-" + dayKey(Date.now()) + ".csv", data: new Blob(["﻿" + lines.join("\r\n")], { type: "text/csv" }) }); setStatus(""); }
  catch (e) { if (e && e.code !== "declined") setStatus("Export failed. Please try again.", "warn"); }
}

// ================= Events & startup =================
$("#newBtn").addEventListener("click", () => openPanel(null));
$("#csvBtn").addEventListener("click", exportCsv);
$("#backdrop").addEventListener("click", () => closePanel());
document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !$("#panel").hidden) closePanel(); });

let rT = null;
function scheduleRender() {
  if (rT) return;
  rT = requestAnimationFrame(() => {
    rT = null;
    const active = document.activeElement;
    const inPanel = active && $("#panel").contains(active) && (active.tagName === "INPUT" || active.tagName === "TEXTAREA" || active.tagName === "SELECT");
    const inMain = active && $("#main").contains(active) && (active.tagName === "INPUT" || active.tagName === "TEXTAREA");
    if (!inMain) render(); else renderTabs();
    if (!$("#panel").hidden && S.openId && !inPanel) buildPanel();
  });
}
function mapInto(map) { return (snap) => { clearMemo(); map.clear(); for (const d of snap.docs) map.set(d.id, { id: d.id, ...d.data() }); scheduleRender(); }; }
function onErr(e) { setStatus(e && e.code === "revoked" ? "Database access was removed for this page." : "Database connection lost. Reload the page.", "crit"); }

async function init() {
  render();
  const use = (n) => (window.claude && window.claude.use ? window.claude.use(n).catch(() => null) : Promise.resolve(null));
  const [db, user, assets, downloads] = await Promise.all([use("db"), use("user"), use("assets"), use("downloads")]);
  Object.assign(S, { db, user, assets, downloads, ready: true });
  if (user) {
    try {
      const me = await user.me(); S.me = me.id; if (me.id && me.name) S.names[me.id] = me.name;
      const w = await user.can("data.write"); if (w === false) S.canWrite = false;
      S.canAdmin = await user.canEdit();
      $("#who").textContent = (me.name || "Signed in") + (S.canWrite === false ? " · read only" : " · live");
    } catch (e) { $("#who").textContent = "Live"; }
  } else $("#who").textContent = db ? "Live" : "Offline";
  if (!db) { render(); return; }
  const bk = db.collection("bookings");
  bk.where("closed", "==", false).onSnapshot(mapInto(S.open), onErr);
  bk.where("closed", "==", true).orderBy("updatedAt", "desc").limit(100).onSnapshot(mapInto(S.closed), onErr);
  db.collection("transporters").onSnapshot(mapInto(S.transporters), onErr);
  db.collection("stacks").onSnapshot(mapInto(S.stacks), onErr);
  db.collection("exceptions").onSnapshot(mapInto(S.exceptions), onErr);
  db.collection("teamdays").onSnapshot(mapInto(S.teamdays), onErr);
  db.collection("settings").onSnapshot((snap) => {
    for (const d of snap.docs) {
      if (d.id === "roles") { const r = d.data(); S.roles = { logistics: r.logistics || [], production: r.production || [], loading: r.loading || [], finance: r.finance || [] }; }
      if (d.id === "params") { S.params = { ...DEFAULT_PARAMS, ...d.data() }; clearMemo(); }
    }
    scheduleRender();
  }, onErr);
  render();
  // the clock is part of the data: 14:00 / 17:00 limits, truck-stay limits and day changes must update without a reload
  setInterval(() => { if (!document.hidden) scheduleRender(); }, 60000);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) scheduleRender(); });
}
init();
})();
</script>
