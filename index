<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>Export Container Register · Green Charcoal Namibia</title>
<meta name="description" content="Booking, container and transporter register for charcoal export loadings out of Walvis Bay.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
/* base reset (the hosting runtime used to provide this) */
:root{color-scheme:light}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0}
img{max-width:100%}
[hidden]:not([hidden=until-found i]){display:none!important}

/* Layout: booking-centric work tool — my actions + bookings list, flat container view, transporters, settings; booking record in a wide side panel. */
:root{
  --bg:#F2F4F3; --surface:#FFFFFF; --surface-2:#E8ECEA; --line:#D2D9D6; --fg:#16201C; --muted:#5A6762;
  --accent:#0E6B5C; --accent-soft:#D9EDE8; --accent-fg:#FFFFFF;
  --ok:#1D7440; --ok-soft:#DDF1E3; --warn:#9A5B00; --warn-soft:#FBEBCF; --crit:#B42318; --crit-soft:#FBE0DC;
  --shadow:0 12px 40px rgba(16,32,28,.18);
  --f-display:"Archivo","Helvetica Neue",Arial,sans-serif;
  --f-body:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0E1412; --surface:#151D1A; --surface-2:#1D2723; --line:#2B3732; --fg:#E3EAE7; --muted:#92A19B;
  --accent:#4DB6A1; --accent-soft:#163A33; --accent-fg:#062019;
  --ok:#5CC27F; --ok-soft:#173825; --warn:#E3A13A; --warn-soft:#3A2B12; --crit:#F07A6C; --crit-soft:#3F1C18;
  --shadow:0 12px 40px rgba(0,0,0,.5); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0E1412; --surface:#151D1A; --surface-2:#1D2723; --line:#2B3732; --fg:#E3EAE7; --muted:#92A19B;
  --accent:#4DB6A1; --accent-soft:#163A33; --accent-fg:#062019;
  --ok:#5CC27F; --ok-soft:#173825; --warn:#E3A13A; --warn-soft:#3A2B12; --crit:#F07A6C; --crit-soft:#3F1C18;
  --shadow:0 12px 40px rgba(0,0,0,.5); color-scheme:dark}

*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--fg);font:14px/1.45 var(--f-body);
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 48px}
.wrap{max-width:1440px;margin:0 auto;display:flex;flex-direction:column;gap:16px}
h1,h2,h3,h4{font-family:var(--f-display);margin:0;text-wrap:balance}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.muted{color:var(--muted)}
.eyebrow{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.hint{font-size:12px;color:var(--muted)}
.err{font-size:12.5px;color:var(--crit)}
p{margin:0}

.top{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px}
.top h1{font-size:26px;font-weight:700;letter-spacing:-.01em}
.top .who{font-size:12px;color:var(--muted);margin-top:2px}
.actions{display:flex;flex-wrap:wrap;gap:8px}
.btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:8px 12px;cursor:pointer;font-weight:500;white-space:nowrap}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
.btn.primary:hover{filter:brightness(1.07)}
.btn.danger{color:var(--crit);border-color:var(--crit)}
.btn.ghost{background:transparent;border-color:transparent}
.btn.sm{padding:5px 9px;font-size:13px}
.btn.xs{padding:3px 8px;font-size:12px;border-radius:6px}
.btn:disabled{opacity:.5;cursor:not-allowed}

.tabs{display:flex;gap:2px;border-bottom:1px solid var(--line);overflow-x:auto}
.tabs button{all:unset;cursor:pointer;padding:9px 14px;font-weight:600;font-size:13.5px;color:var(--muted);border-bottom:2px solid transparent;white-space:nowrap}
.tabs button[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--accent)}
.tabs button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.tabs .n{font-family:var(--f-mono);font-size:11.5px;margin-left:6px;padding:1px 6px;border-radius:999px;background:var(--surface-2)}

.bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;font-size:13px;font-weight:500;border:1px solid transparent}
.chip b{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.chip.crit{background:var(--crit-soft);color:var(--crit)}
.chip.warn{background:var(--warn-soft);color:var(--warn)}
.chip.info{background:var(--surface-2);color:var(--fg)}
.chip[aria-pressed="true"]{border-color:currentColor}
.chip:focus-visible{outline:2px solid var(--accent)}
.tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.search{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:8px 10px;min-width:0;width:240px;max-width:100%}
.check{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--muted);cursor:pointer}

.status{font-size:12.5px;padding:8px 12px;border-radius:8px;background:var(--surface-2);color:var(--muted)}
.status.warn{background:var(--warn-soft);color:var(--warn)}
.status.crit{background:var(--crit-soft);color:var(--crit)}

.pill{display:inline-flex;align-items:center;font-size:11.5px;font-weight:600;padding:2px 7px;border-radius:999px;background:var(--surface-2);color:var(--muted);white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
.pill.crit{background:var(--crit-soft);color:var(--crit)}
.pill.warn{background:var(--warn-soft);color:var(--warn)}
.pill.ok{background:var(--ok-soft);color:var(--ok)}
.pill.accent{background:var(--accent-soft);color:var(--accent)}
.pills{display:flex;flex-wrap:wrap;gap:4px}

/* My actions */
.section-h{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:8px}
.section-h h2{font-size:16px;font-weight:600}
.todo{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px}
.todo-item{all:unset;box-sizing:border-box;cursor:pointer;background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:4px;min-width:0}
.todo-item.late{border-left-color:var(--crit)}
.todo-item:hover{border-color:var(--muted)}
.todo-item:focus-visible{outline:2px solid var(--accent)}
.todo-item .t{font-weight:600}
.todo-item .m{font-size:12.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* Booking cards */
.bookings{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:12px}
.bk{all:unset;box-sizing:border-box;cursor:pointer;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px;display:flex;flex-direction:column;gap:8px;min-width:0}
.bk:hover{border-color:var(--muted)}
.bk:focus-visible{outline:2px solid var(--accent)}
.bk .row{display:flex;justify-content:space-between;gap:8px;align-items:baseline;min-width:0}
.bk .row > *{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bk .no{font-family:var(--f-mono);font-weight:600;font-size:15px}
.bk .sub{font-size:12.5px;color:var(--muted)}
.bk .next{font-size:13px;background:var(--surface-2);border-radius:6px;padding:6px 8px;display:flex;flex-direction:column;gap:1px}
.bk .next b{font-weight:600}
.cbar{display:flex;gap:3px}
.cbar i{flex:1;height:6px;border-radius:3px;background:var(--line)}
.cbar i.s1{background:color-mix(in srgb,var(--accent) 25%,var(--line))}
.cbar i.s2,.cbar i.s3{background:color-mix(in srgb,var(--accent) 55%,var(--line))}
.cbar i.s4,.cbar i.s5{background:color-mix(in srgb,var(--accent) 80%,var(--line))}
.cbar i.s6{background:var(--ok)}
.legend{display:flex;flex-wrap:wrap;gap:10px;font-size:11.5px;color:var(--muted)}

/* Tables */
.table-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:13px}
.wide table{min-width:960px}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap;vertical-align:middle}
th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600;background:var(--surface-2)}
tbody tr:last-child td{border-bottom:0}
tr.click{cursor:pointer}
tr.click:hover{background:var(--surface-2)}
td.num{font-family:var(--f-mono);font-weight:600}
td input,td select{border:1px solid var(--line);background:var(--bg);border-radius:6px;padding:4px 6px;max-width:150px}
td input.mono{text-transform:uppercase}

.empty{border:1.5px dashed var(--line);border-radius:12px;padding:32px 20px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px;background:var(--surface)}
.empty h2{font-size:18px}
.empty p{max-width:56ch;color:var(--muted)}

/* Panel */
.backdrop{position:fixed;inset:0;background:rgba(10,18,15,.42);z-index:20}
.panel{position:fixed;top:0;right:0;bottom:0;width:min(880px,100%);background:var(--bg);z-index:21;box-shadow:var(--shadow);display:flex;flex-direction:column;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);padding-right:env(safe-area-inset-right,0px)}
.panel-h{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:16px 20px 12px;border-bottom:1px solid var(--line);background:var(--surface)}
.panel-h .big{font-family:var(--f-mono);font-size:22px;font-weight:600;letter-spacing:.02em}
.panel-tabs{padding:0 20px;background:var(--surface)}
.panel-b{overflow-y:auto;padding:16px 20px 40px;display:flex;flex-direction:column;gap:16px}
.sec{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:12px;min-width:0}
.sec.hl{border-color:var(--accent);box-shadow:inset 3px 0 0 var(--accent)}
.sec-h{display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap}
.sec-h h3{font-size:15px;font-weight:600}

.next-card{display:flex;flex-direction:column;gap:8px;padding:12px;border-radius:8px;background:var(--surface-2)}
.next-card + .next-card{margin-top:4px}
.next-card .head{display:flex;justify-content:space-between;gap:8px;align-items:flex-start;flex-wrap:wrap}
.next-card .title{font-weight:600;font-size:14.5px}
.next-card .stepno{font-family:var(--f-mono);color:var(--muted);margin-right:6px}
.next-card ul{margin:0;padding-left:18px;font-size:13px;display:flex;flex-direction:column;gap:2px}
.owner{font-size:12.5px;color:var(--muted)}
.owner b{color:var(--fg);font-weight:600}
.control{font-size:12.5px;border-left:3px solid var(--warn);padding:2px 0 2px 8px;color:var(--fg)}
.gate{border-radius:8px;padding:10px 12px;background:var(--warn-soft);color:var(--warn);font-size:13px;display:flex;flex-direction:column;gap:8px}
.gate ul{margin:0;padding-left:18px}
.row-btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center}

.alerts-list{display:flex;flex-direction:column;gap:6px;margin:0;padding:0;list-style:none}
.alerts-list li{display:flex;gap:8px;align-items:baseline;font-size:13px}

.steps{display:flex;flex-direction:column}
.phase{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;padding:10px 0 4px}
.step{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:4px 10px;padding:7px 0;border-top:1px solid var(--line);align-items:center}
.step .dot{width:20px;height:20px;border-radius:50%;border:2px solid var(--line);display:grid;place-items:center;font-size:11px;font-family:var(--f-mono);color:var(--muted)}
.step.done .dot{background:var(--ok);border-color:var(--ok);color:var(--accent-fg)}
.step.open .dot{border-color:var(--accent);color:var(--accent)}
.step.late .dot{border-color:var(--crit);color:var(--crit)}
.step .lbl{font-size:13.5px;min-width:0}
.step .lbl small{display:block;font-size:12px;color:var(--muted)}
.step.done .lbl{color:var(--muted)}

.docs{display:flex;flex-direction:column}
.doc{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 10px;padding:8px 0;border-top:1px solid var(--line);align-items:center}
.doc:first-child{border-top:0}
.doc .files{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.file{display:inline-flex;align-items:center;gap:4px;border:1px solid var(--line);border-radius:6px;padding:2px 4px 2px 8px;font-size:12.5px;max-width:100%}
.file a{color:var(--accent);text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:220px}
.file a:hover{text-decoration:underline}
.file button{all:unset;cursor:pointer;color:var(--muted);padding:0 4px;font-size:13px;line-height:1}
.file button:hover{color:var(--crit)}
.upl{font-size:12.5px;color:var(--accent);cursor:pointer;font-weight:500;display:inline-flex;align-items:center;gap:4px;position:relative}
.upl input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.upl:focus-within{outline:2px solid var(--accent);border-radius:4px}

.form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px 12px}
.form .full{grid-column:1/-1}
@media (max-width:720px){.form{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:460px){.form{grid-template-columns:minmax(0,1fr)}}
.f{display:flex;flex-direction:column;gap:4px;min-width:0}
.f label{font-size:12px;color:var(--muted);font-weight:500}
.f input,.f select,.f textarea{border:1px solid var(--line);background:var(--bg);border-radius:7px;padding:8px 9px;width:100%;min-width:0}
.f input.mono{text-transform:uppercase;letter-spacing:.03em}
.f textarea{min-height:64px;resize:vertical}
.f.checkf{flex-direction:row;align-items:center;gap:8px;padding-top:20px}
.form-actions{display:flex;justify-content:flex-end;gap:8px;align-items:center;flex-wrap:wrap}

.advice{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}
.tb-bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:4px 0 10px}
.tb-bar .day{font-weight:700;min-width:150px;text-align:center}
.tb-lim{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 10px}
.trip{display:grid;grid-template-columns:92px minmax(0,1fr) auto;gap:10px 14px;align-items:start;border:1px solid var(--line);border-left:4px solid var(--line);border-radius:8px;padding:10px 12px;background:var(--surface);margin-bottom:8px}
.trip.ok{border-left-color:var(--ok)} .trip.crit{border-left-color:var(--crit)} .trip.warn{border-left-color:var(--warn)}
.trip .tt{font-family:var(--f-mono);font-variant-numeric:tabular-nums;display:flex;flex-direction:column;gap:2px}
.trip .tt b{font-size:17px} .trip .tt span{font-size:11.5px;color:var(--muted)}
.trip .nm{font-weight:700} .trip .iss{color:var(--crit);font-size:13px;margin-top:4px}
.trip .opts{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;align-items:center}
.trip .opts .btn{white-space:normal;text-align:left;max-width:100%;height:auto;min-height:26px}
.trip > div{min-width:0}
.tb-lim .pill{white-space:normal;max-width:100%}
.trip .acts{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end;max-width:330px}
.trip .acts input[type=time]{width:96px}
@media (max-width:720px){.trip{grid-template-columns:70px minmax(0,1fr)}.trip .acts{grid-column:1/-1;justify-content:flex-start;max-width:none}}
.tl{position:relative;min-width:760px}
.tl-row{display:grid;grid-template-columns:170px minmax(0,1fr);align-items:center;border-bottom:1px solid var(--line);min-height:38px}
.tl-lab{font-size:12px;line-height:1.25;padding:3px 8px 3px 0;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.tl-track{position:relative;height:34px}
.tl-b{position:absolute;top:7px;height:20px;border-radius:4px;font-size:10.5px;line-height:20px;padding:0 4px;overflow:hidden;white-space:nowrap;color:var(--fg)}
.tl-b.drive{background:var(--surface-2);border:1px dashed var(--line)}
.tl-b.wait{background:repeating-linear-gradient(135deg,var(--warn-soft) 0 4px,transparent 4px 8px);border:1px solid var(--warn)}
.tl-b.load{background:var(--accent);color:var(--accent-fg)}
.tl-b.road{background:var(--accent-soft);border:1px solid var(--accent)}
.tl-b.bad{outline:2px solid var(--crit)}
.tl-b.done{opacity:.55}
.tl-v{position:absolute;top:0;bottom:0;width:0;border-left:2px solid var(--muted);z-index:2;pointer-events:none}
.tl-v.now{border-left-color:var(--crit)} .tl-v.lim{border-left:2px dashed var(--warn)}
.tl-v span{position:absolute;bottom:-19px;left:3px;font-size:10.5px;white-space:nowrap;color:var(--muted);background:var(--bg);padding:0 2px}
.tl-v.now span{color:var(--crit)}
.tl-hours{position:relative;height:22px;margin-left:170px}
.tl-hours span{position:absolute;font-size:10.5px;color:var(--muted);transform:translateX(-50%)}
.tl-legend{display:flex;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--muted);margin-top:8px}
.tl-legend i{display:inline-block;width:18px;height:10px;border-radius:2px;margin-right:4px;vertical-align:middle}
.scen{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
@media (max-width:760px){.scen{grid-template-columns:1fr}}
.scn{border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:6px;background:var(--bg);min-width:0}
.scn.on{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.scn .nm{font-weight:700;display:flex;justify-content:space-between;gap:8px;align-items:center}
.scn .big{font-family:var(--f-mono);font-size:15px;font-weight:700}
.scn dl{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;margin:0;font-size:12.5px}
.scn dt{color:var(--muted)} .scn dd{margin:0;text-align:right}
.scn ul{margin:0;padding-left:16px;font-size:12px;color:var(--muted)}
.prefbar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:4px 0 10px}
.opt{border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:4px;background:var(--bg);min-width:0}
.opt.best{border-color:var(--ok);box-shadow:inset 0 3px 0 var(--ok)}
.opt .k{font-weight:600}
.opt .v{font-family:var(--f-mono);font-size:18px;font-weight:600;font-variant-numeric:tabular-nums}
.sched{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px}
.sched div{border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:var(--bg);display:flex;flex-direction:column;gap:2px}
.sched b{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.rank{display:flex;flex-direction:column;gap:6px}
.rank-row{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:10px;align-items:center;border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:var(--bg)}
.rank-row.top{border-color:var(--ok)}
.rank-row .pos{font-family:var(--f-mono);color:var(--muted)}
.rank-row .nm{font-weight:600}
.rank-row .meta{font-size:12px;color:var(--muted)}

.solver-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap}
.solver-head h2{font-size:20px;font-weight:700}
.dec-group{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-top:4px}
.dec-list{display:flex;flex-direction:column;gap:8px}
