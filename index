        <input id="authPass" type="password" autocomplete="current-password" required>
      </label>
      <button class="btn primary" id="authSubmit" type="submit">Sign in</button>
      <p class="auth-msg hint" id="authMsg"></p>
      <p class="auth-foot">Accounts are created in Supabase by whoever administers this register. Bookings, transporters and attachments are only visible once you are signed in.</p>
    </form>

    <div id="authSetup" class="auth-setup" hidden>
      <p class="hint">This copy is not connected to a database yet.</p>
      <ol>
        <li>Create a project at <code>supabase.com</code>.</li>
        <li>Run <code>supabase/schema.sql</code> from this repository in the project's SQL editor.</li>
        <li>Copy the project URL and the <code>anon</code> key from <em>Project Settings → API</em>.</li>
        <li>Paste both into <code>window.ECR_CONFIG</code> at the top of <code>index.html</code>, commit, and reload this page.</li>
      </ol>
      <p class="auth-foot">The full steps, including creating the first user account, are in <code>README.md</code>.</p>
    </div>
  </div>
</div>

<!-- =====================================================================
     CONNECTION SETTINGS · the only part of this file you need to edit
     Project Settings -> API in your Supabase dashboard.
     The anon key is meant to be public: what each person may read or
     write is decided by the row-level security policies in
     supabase/schema.sql, not by keeping this key secret.
     ===================================================================== -->
<script>
window.ECR_CONFIG = {
  supabaseUrl:     "https://YOUR-PROJECT.supabase.co",
  supabaseAnonKey: "YOUR-ANON-KEY",
  storageBucket:   "attachments"
};
</script>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.118.0/dist/umd/supabase.js" crossorigin="anonymous"></script>

<script>
/* =============================================================================
 * Supabase backend adapter for the Export Container Register
 * -----------------------------------------------------------------------------
 * The application below this script was written for the Claude artifact runtime,
 * where it receives four capabilities from `window.claude.use(name)`:
 *
 *     db         a document database with live queries (Firestore-shaped)
 *     user       the signed-in person, their display name and permissions
 *     assets     file attachments
 *     downloads  saving a generated file to the computer
 *
 * This file re-implements those four capabilities on top of Supabase, so the
 * application code itself is used unchanged. Nothing below this script was
 * modified.
 *
 *     db         -> table public.docs (collection, id, data jsonb) + Realtime
 *     user       -> Supabase Auth + table public.profiles
 *     assets     -> Supabase Storage, bucket "attachments"
 *     downloads  -> an ordinary browser download
 *
 * See supabase/schema.sql for the tables, functions and row-level security
 * policies this adapter expects, and README.md for the setup steps.
 * ========================================================================== */
(function () {
  "use strict";

  var CFG = window.ECR_CONFIG || {};
  var URL_OK = typeof CFG.supabaseUrl === "string" && /^https?:\/\//.test(CFG.supabaseUrl) && CFG.supabaseUrl.indexOf("YOUR-PROJECT") === -1;
  var KEY_OK = typeof CFG.supabaseAnonKey === "string" && CFG.supabaseAnonKey.length > 20 && CFG.supabaseAnonKey.indexOf("YOUR-ANON-KEY") === -1;
  var CONFIGURED = URL_OK && KEY_OK;

  /* --- small helpers ------------------------------------------------------ */

  var $ = function (s) { return document.querySelector(s); };

  function fail(code, message) {
    var e = new Error(message || code);
    e.code = code;
    return e;
  }

  // Supabase/PostgREST errors -> the error codes the application already knows.
  function mapErr(e) {
    if (!e) return fail("failed", "Unknown error");
    var msg = String(e.message || e.error_description || e.error || e);
    var code = String(e.code || e.statusCode || "");
    if (code === "42501" || /row-level security|permission denied|not authori[sz]ed|violates/i.test(msg)) return fail("invalid_argument", msg);
    if (code === "53100" || code === "54000" || /quota|disk full|payload too large|exceeded the maximum|too large/i.test(msg)) return fail("quota_exceeded", msg);
    if (code === "429" || /rate limit|too many requests/i.test(msg)) return fail("rate_limited", msg);
    if (/jwt|invalid token|session|refresh_token/i.test(msg)) return fail("revoked", msg);
    return fail("failed", msg);
  }

  var ID_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
  function newId() {
    var out = "", i, r = new Uint8Array(20);
    (window.crypto || {}).getRandomValues ? window.crypto.getRandomValues(r) : r.forEach(function (_, k) { r[k] = Math.floor(Math.random() * 256); });
    for (i = 0; i < 20; i++) out += ID_CHARS[r[i] % ID_CHARS.length];
    return out;
  }

  var UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

  // JSON-safe copy. undefined keys disappear (no change requested); null is kept
  // on purpose: in a patch it means "remove this key", same as the original runtime.
  function clean(v) {
    try { return JSON.parse(JSON.stringify(v === undefined ? null : v)); }
    catch (e) { throw fail("invalid_argument", "This change could not be saved (unsupported value)."); }
  }

  function field(obj, path) {
    if (!obj) return undefined;
    if (path.indexOf(".") === -1) return obj[path];
    return path.split(".").reduce(function (o, k) { return o == null ? undefined : o[k]; }, obj);
  }

  function match(a, op, b) {
    // a missing boolean field reads as false, so documents written before a flag
    // existed still answer where("closed", "==", false)
    if (a === undefined && typeof b === "boolean") a = false;
    switch (op) {
      case "==": return a === b;
      case "!=": return a !== b;
      case "<": return a < b;
      case "<=": return a <= b;
      case ">": return a > b;
      case ">=": return a >= b;
      case "in": return Array.isArray(b) && b.indexOf(a) !== -1;
      case "array-contains": return Array.isArray(a) && a.indexOf(b) !== -1;
      default: return true;
    }
  }

  function cmp(a, b) {
    if (a === b) return 0;
    if (a === undefined || a === null) return -1;
    if (b === undefined || b === null) return 1;
    if (typeof a === "number" && typeof b === "number") return a - b;
    return String(a) < String(b) ? -1 : 1;
  }

  /* --- db ----------------------------------------------------------------- */

  function makeDb(sb) {
    var colls = new Map();

    function snapshot(q, c) {
      var rows = [];
      c.docs.forEach(function (data, id) {
        for (var i = 0; i < q.filters.length; i++) {
          var f = q.filters[i];
          if (!match(field(data, f.f), f.op, f.v)) return;
        }
        rows.push({ id: id, data: function () { return data; } });
      });
      if (q.order) {
        var dir = q.order.dir, key = q.order.f;
        rows.sort(function (a, z) { return cmp(field(a.data(), key), field(z.data(), key)) * dir; });
      }
      if (q.lim != null) rows = rows.slice(0, q.lim);
      return { docs: rows, size: rows.length, empty: rows.length === 0 };
    }

    function emit(c, l) {
      if (!c.loaded) return;
      try { l.cb(snapshot(l.q, c)); } catch (e) { console.error("[ecr] snapshot handler failed", e); }
    }
    function emitAll(c) { c.listeners.forEach(function (l) { emit(c, l); }); }
    function broke(c, e) {
      c.broken = e;
      c.listeners.forEach(function (l) { if (l.err) try { l.err(e); } catch (_) {} });
    }

    function getColl(name) {
      var c = colls.get(name);
      if (c) return c;
      c = { name: name, docs: new Map(), listeners: new Set(), loaded: false, broken: null, gone: new Set(), channel: null };
      colls.set(name, c);

      // Subscribe before the first read, so a change made while the read is in
      // flight is not lost.
      c.channel = sb.channel("docs:" + name)
        .on("postgres_changes", { event: "*", schema: "public", table: "docs", filter: "collection=eq." + name }, function (p) {
          if (p.eventType === "DELETE") {
            var gid = p.old && p.old.id;
            if (gid) { c.docs.delete(gid); if (!c.loaded) c.gone.add(gid); }
          } else if (p.new && p.new.id) {
            c.docs.set(p.new.id, p.new.data || {});
            if (!c.loaded) c.gone.delete(p.new.id);
          }
          emitAll(c);
        })
        .subscribe(function (status) {
          if (status === "CHANNEL_ERROR" || status === "TIMED_OUT" || status === "CLOSED") {
            if (c.loaded) broke(c, fail("connection", "Live updates stopped."));
          }
        });

      sb.from("docs").select("id,data").eq("collection", name).then(function (res) {
        if (res.error) { broke(c, mapErr(res.error)); return; }
        (res.data || []).forEach(function (r) {
          if (c.docs.has(r.id) || c.gone.has(r.id)) return; // a live event already told us something newer
          c.docs.set(r.id, r.data || {});
        });
        c.loaded = true;
        c.gone.clear();
        emitAll(c);
      }, function (e) { broke(c, mapErr(e)); });

      return c;
    }

    function makeDocRef(name, id) {
      var docId = id || newId();
      return {
        id: docId,
        set: function (data) {
          return sb.from("docs").upsert({ collection: name, id: docId, data: clean(data), updated_at: new Date().toISOString() }, { onConflict: "collection,id" })
            .then(function (r) { if (r.error) throw mapErr(r.error); });
        },
        // deep merge, null removes the key — same rules as the original runtime,
        // applied inside Postgres so two people saving at once do not overwrite
        // each other's fields
        update: function (patch) {
          return sb.rpc("doc_update", { p_collection: name, p_id: docId, p_patch: clean(patch) })
            .then(function (r) { if (r.error) throw mapErr(r.error); });
        },
        delete: function () {
          return sb.from("docs").delete().eq("collection", name).eq("id", docId)
            .then(function (r) { if (r.error) throw mapErr(r.error); });
        },
        get: function () {
          return sb.from("docs").select("data").eq("collection", name).eq("id", docId).maybeSingle()
            .then(function (r) {
              if (r.error) throw mapErr(r.error);
              var d = r.data ? r.data.data : null;
              return { id: docId, exists: !!r.data, data: function () { return d; } };
            });
        }
      };
    }

    function makeQuery(name, filters, order, lim) {
      return {
        where: function (f, op, v) { return makeQuery(name, filters.concat([{ f: f, op: op, v: v }]), order, lim); },
        orderBy: function (f, dir) { return makeQuery(name, filters, { f: f, dir: dir === "desc" ? -1 : 1 }, lim); },
        limit: function (n) { return makeQuery(name, filters, order, n); },
        doc: function (id) { return makeDocRef(name, id); },
        onSnapshot: function (cb, errCb) {
          var c = getColl(name);
          var l = { q: { filters: filters, order: order, lim: lim }, cb: cb, err: errCb };
          c.listeners.add(l);
          if (c.broken) { if (errCb) errCb(c.broken); } else emit(c, l);
          return function () { c.listeners.delete(l); };
        },
        get: function () {
          var c = getColl(name), q = { filters: filters, order: order, lim: lim };
          return new Promise(function (res, rej) {
            if (c.broken) return rej(c.broken);
            if (c.loaded) return res(snapshot(q, c));
            var l = { q: q, cb: function (s) { c.listeners.delete(l); res(s); }, err: function (e) { c.listeners.delete(l); rej(e); } };
            c.listeners.add(l);
          });
        }
      };
    }

    return { collection: function (name) { return makeQuery(name, [], null, null); } };
  }

  /* --- user --------------------------------------------------------------- */

  function makeUser(sb, session, profile) {
    var me = { id: session.user.id, name: profile.name || session.user.email };
    return {
      me: function () { return Promise.resolve(me); },
      can: function (what) { return Promise.resolve(what === "data.write" ? profile.role !== "viewer" : true); },
      canEdit: function () { return Promise.resolve(profile.role === "admin"); },
      profiles: function (ids) {
        var want = (ids || []).filter(function (i) { return UUID_RE.test(i); });
        if (!want.length) return Promise.resolve({});
        return sb.from("profiles").select("id,name,email").in("id", want).then(function (r) {
          var out = {};
          (r.data || []).forEach(function (p) { out[p.id] = { id: p.id, name: p.name || p.email }; });
          return out;
        });
      },
      search: function (q) {
        var t = String(q || "").replace(/[,()%*]/g, "").trim();
        if (t.length < 2) return Promise.resolve([]);
        return sb.from("profiles").select("id,name,email").or("name.ilike.%" + t + "%,email.ilike.%" + t + "%").limit(8).then(function (r) {
          return (r.data || []).map(function (p) { return { id: p.id, name: p.name || p.email }; });
        });
      }
    };
  }

  /* --- assets (Supabase Storage) ------------------------------------------ */

  var BUCKET = CFG.storageBucket || "attachments";

  function safeName(n) {
    return String(n || "file").normalize("NFKD").replace(/[^\w.\- ]+/g, "_").replace(/\s+/g, " ").trim().slice(-120) || "file";
  }

  function makeAssets(sb) {
    var store = sb.storage.from(BUCKET);

    function pathOf(id) {
      return store.list(id, { limit: 1 }).then(function (r) {
        if (r.error) throw mapErr(r.error);
        var f = (r.data || [])[0];
        return f ? id + "/" + f.name : null;
      });
    }

    return {
      upload: function (file, opts) {
        var id = newId(), path = id + "/" + safeName(file.name);
        return store.upload(path, file, { contentType: (opts && opts.type) || file.type || "application/octet-stream", upsert: false })
          .then(function (r) {
            if (r.error) throw mapErr(r.error);
            return { id: id, sizeBytes: file.size, name: file.name };
          });
      },
      delete: function (id) {
        return pathOf(id).then(function (p) {
          if (!p) return;
          return store.remove([p]).then(function (r) { if (r.error) throw mapErr(r.error); });
        });
      },
      // the application links attachments as /_blob/<id>; openUrl turns one into
      // a short-lived signed link
      openUrl: function (id) {
        return pathOf(id).then(function (p) {
          if (!p) throw fail("not_found", "This file is no longer stored.");
          return store.createSignedUrl(p, 300).then(function (r) {
            if (r.error) throw mapErr(r.error);
            return r.data.signedUrl;
          });
        });
      }
    };
  }

  /* --- downloads ---------------------------------------------------------- */

  var downloads = {
    save: function (opts) {
      return new Promise(function (res, rej) {
        try {
          var url = URL.createObjectURL(opts.data);
          var a = document.createElement("a");
          a.href = url;
          a.download = opts.filename || "download";
          document.body.appendChild(a);
          a.click();
          setTimeout(function () { a.remove(); URL.revokeObjectURL(url); }, 2000);
          res();
        } catch (e) { rej(mapErr(e)); }
      });
    }
  };

  /* --- sign-in screen ----------------------------------------------------- */

  var release;                                   // hands the capabilities to the app
  var ready = new Promise(function (r) { release = r; });
  window.claude = {
    use: function (name) { return ready.then(function (caps) { return caps[name] || null; }); }
  };

  function gate() { return $("#authGate"); }
  function showGate(view) {
    gate().hidden = false;
    $("#authWait").hidden = true;
    $("#authSetup").hidden = view !== "setup";
    $("#authForm").hidden = view !== "form";
  }
  function authMsg(text, bad) {
    var el = $("#authMsg");
    el.textContent = text || "";
    el.className = bad ? "auth-msg err" : "auth-msg hint";
  }

  function addSignOut(sb, label) {
    var bar = document.querySelector(".top .actions");
    if (!bar || $("#signOutBtn")) return;
    var b = document.createElement("button");
    b.id = "signOutBtn";
    b.className = "btn";
    b.type = "button";
    b.title = label || "";
    b.textContent = "Sign out";
    b.addEventListener("click", function () {
      sb.auth.signOut().then(function () { location.reload(); });
    });
    bar.appendChild(b);
  }

  // attachments: /_blob/<id> -> signed Storage link
  function interceptBlobLinks(assets) {
    document.addEventListener("click", function (ev) {
      var a = ev.target && ev.target.closest ? ev.target.closest('a[href*="/_blob/"]') : null;
      if (!a) return;
      ev.preventDefault();
      var id = a.getAttribute("href").split("/_blob/")[1];
      if (!id) return;
      var tab = window.open("", "_blank");       // opened synchronously, or the browser blocks it
      assets.openUrl(id).then(function (url) {
        if (tab) tab.location = url; else window.location = url;
      }, function (e) {
        if (tab) tab.close();
        var s = $("#status");
        if (s) { s.hidden = false; s.className = "status warn"; s.textContent = e.code === "not_found" ? "That file is no longer stored." : "Could not open the file."; }
      });
    }, true);
  }

  function profileFor(sb, session) {
    return sb.from("profiles").select("name,role").eq("id", session.user.id).maybeSingle().then(function (r) {
      if (r.data) return r.data;
      // first sign-in on a project where the trigger did not run: create the row
      var guess = { id: session.user.id, name: (session.user.user_metadata || {}).full_name || session.user.email.split("@")[0], email: session.user.email };
      return sb.from("profiles").insert(guess).select("name,role").maybeSingle().then(function (ins) {
        return ins.data || { name: guess.name, role: "editor" };
      }, function () { return { name: guess.name, role: "editor" }; });
    }, function () { return { name: session.user.email, role: "editor" }; });
  }

  function start(sb, session) {
    profileFor(sb, session).then(function (profile) {
      var assets = makeAssets(sb);
      interceptBlobLinks(assets);
      addSignOut(sb, session.user.email);
      gate().hidden = true;
      release({ db: makeDb(sb), user: makeUser(sb, session, profile), assets: assets, downloads: downloads });
    });
  }

  function boot() {
    if (!CONFIGURED) { showGate("setup"); return; }
    if (!window.supabase || !window.supabase.createClient) {
      showGate("form");
      authMsg("The Supabase library could not be loaded. Check this computer's internet connection, then reload.", true);
      $("#authForm").querySelectorAll("input,button").forEach(function (el) { el.disabled = true; });
      return;
    }

    var sb = window.supabase.createClient(CFG.supabaseUrl, CFG.supabaseAnonKey, {
      auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: false }
    });

    $("#authForm").addEventListener("submit", function (ev) {
      ev.preventDefault();
      var btn = $("#authSubmit");
      var email = $("#authEmail").value.trim();
      var pass = $("#authPass").value;
      if (!email || !pass) { authMsg("Enter your email address and password.", true); return; }
      btn.disabled = true;
      authMsg("Signing in…", false);
      sb.auth.signInWithPassword({ email: email, password: pass }).then(function (r) {
        btn.disabled = false;
        if (r.error) {
          authMsg(/invalid login/i.test(r.error.message) ? "That email address and password do not match an account." : r.error.message, true);
          return;
        }
        authMsg("", false);
        start(sb, r.data.session);
      }, function (e) {
        btn.disabled = false;
        authMsg("Could not reach the database. Check your internet connection and try again.", true);
        console.error("[ecr] sign-in failed", e);
      });
    });

    sb.auth.getSession().then(function (r) {
      var session = r.data && r.data.session;
      if (session) start(sb, session);
      else { showGate("form"); setTimeout(function () { $("#authEmail").focus(); }, 60); }
    }, function () {
      showGate("form");
      authMsg("Could not reach the database. Check the project URL in this page's settings.", true);
    });

    sb.auth.onAuthStateChange(function (event) {
      if (event === "SIGNED_OUT") location.reload();
    });
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
})();
</script>

